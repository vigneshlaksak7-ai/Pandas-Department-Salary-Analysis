import pandas as pd

# Employee data
data = {
    'Name': ['Arun', 'Priya', 'Rahul', 'Divya', 'Kavin', 'Anitha'],
    'Department': ['IT', 'HR', 'IT', 'Finance', 'HR', 'Finance'],
    'Salary': [55000, 48000, 62000, 70000, 52000, 65000]
}

df = pd.DataFrame(data)

print("Employee Data:")
print(df)

print("\n" + "=" * 50)

# Department-wise salary analysis
department_analysis = df.groupby('Department')['Salary'].agg(
    ['mean', 'min', 'max', 'count']
)

print("Department-wise Salary Analysis:")
print(department_analysis)

print("\n" + "=" * 50)

# Calculate overall average salary
average_salary = df['Salary'].mean()

print(f"Overall Average Salary: ₹{average_salary:,.2f}")
